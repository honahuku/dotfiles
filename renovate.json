{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "github>aquaproj/aqua-renovate-config#2.15.0"
  ],
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "GitHub Actions の更新をまとめる",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "aqua 管理ツールの更新をまとめる",
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "aqua.yaml"
      ],
      "groupName": "aqua tools"
    },
    {
      "description": "vendir で取り込むスキルの更新をまとめる",
      "matchManagers": [
        "vendir"
      ],
      "groupName": "vendir skills"
    },
    {
      "description": "mise の更新を一つのPRにまとめる",
      "matchPackageNames": [
        "github:jdx/mise",
        "jdx/mise"
      ],
      "groupName": "mise"
    },
    {
      "description": "aqua の更新はリリースから7日以上経過してから行う",
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "aqua.yaml"
      ],
      "minimumReleaseAge": "7 days",
      "minimumReleaseAgeBehaviour": "timestamp-required"
    },
    {
      "description": "Node.js は LTS 到達済みのリリースのみ更新対象にする",
      "matchPackageNames": [
        "node"
      ],
      "versioning": "node"
    },
    {
      "description": "minor と patch 更新を自動マージする",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "vendir で取り込むスキルの更新は自動マージしない",
      "matchManagers": [
        "vendir"
      ],
      "automerge": false
    }
  ]
}
