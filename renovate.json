{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "github>aquaproj/aqua-renovate-config#2.15.0"
  ],
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^os-packages\\/nucbox-g3\\/mise\\.toml$/"
      ],
      "matchStrings": [
        "(?m)^\"apt:(?<depName>[a-z0-9][a-z0-9+.-]*)\" = \"(?<currentValue>[^\"]+)\" # renovate: apt$"
      ],
      "datasourceTemplate": "deb",
      "versioningTemplate": "deb",
      "depTypeTemplate": "apt"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "groupName": "lock file maintenance"
  },
  "packageRules": [
    {
      "description": "GitHub Actions の更新をまとめる",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Node.js の更新を管理元をまたいでまとめる",
      "matchPackageNames": [
        "node",
        "actions/node-versions"
      ],
      "groupName": "Node.js"
    },
    {
      "description": "Python の更新をまとめる",
      "matchPackageNames": [
        "python",
        "astral-sh/uv",
        "astral-sh/ruff"
      ],
      "groupName": "Python"
    },
    {
      "description": "Python プロジェクトの依存更新をまとめる",
      "matchManagers": [
        "pep621"
      ],
      "groupName": "Python"
    },
    {
      "description": "npm / JavaScript 関連の更新をまとめる",
      "matchDatasources": [
        "npm"
      ],
      "groupName": "npm / JavaScript"
    },
    {
      "description": "mise で管理するツールの更新をまとめる",
      "matchManagers": [
        "mise"
      ],
      "groupName": "mise tools"
    },
    {
      "description": "aqua 管理ツールの更新をまとめる",
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "aqua.yaml"
      ],
      "groupName": "aqua tools"
    },
    {
      "description": "vendir で取り込むスキルの更新をまとめる",
      "matchManagers": [
        "vendir"
      ],
      "groupName": "vendir skills"
    },
    {
      "description": "mise の更新を一つのPRにまとめる",
      "matchPackageNames": [
        "github:jdx/mise",
        "jdx/mise"
      ],
      "groupName": "mise"
    },
    {
      "description": "aqua の更新はリリースから7日以上経過してから行う",
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "aqua.yaml"
      ],
      "minimumReleaseAge": "7 days",
      "minimumReleaseAgeBehaviour": "timestamp-required"
    },
    {
      "description": "Node.js は LTS 到達済みのリリースのみ更新対象にする",
      "matchPackageNames": [
        "node"
      ],
      "versioning": "node"
    },
    {
      "description": "minor と patch 更新を自動マージする",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "NucBox G3 の Debian パッケージ更新を一つのPRにまとめ、自動マージしない",
      "matchDepTypes": [
        "apt"
      ],
      "matchDatasources": [
        "deb"
      ],
      "matchFileNames": [
        "os-packages/nucbox-g3/mise.toml"
      ],
      "groupName": "NucBox G3 Debian packages",
      "automerge": false,
      "minimumReleaseAgeBehaviour": "timestamp-optional",
      "registryUrls": [
        "https://deb.debian.org/debian?suite=trixie&components=main,contrib,non-free-firmware&binaryArch=amd64",
        "https://deb.debian.org/debian?suite=trixie-updates&components=main,contrib,non-free-firmware&binaryArch=amd64",
        "https://security.debian.org/debian-security?suite=trixie-security&components=main,contrib,non-free-firmware&binaryArch=amd64"
      ]
    },
    {
      "description": "vendir で取り込むスキルの更新は自動マージしない",
      "matchManagers": [
        "vendir"
      ],
      "automerge": false
    }
  ]
}
