{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "github>aquaproj/aqua-renovate-config#2.15.0"
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "aqua の更新はリリースから14日以上経過してから行う",
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "aqua.yaml"
      ],
      "minimumReleaseAge": "14 days",
      "minimumReleaseAgeBehaviour": "timestamp-required"
    },
    {
      "description": "minor と patch 更新を自動マージする",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "vendir で取り込むスキルの更新は自動マージしない",
      "matchManagers": [
        "vendir"
      ],
      "automerge": false
    }
  ]
}
