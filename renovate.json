{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^vendir\\.yml$/"],
      "matchStrings": [
        "url: (?<packageName>https://github\\.com/mattpocock/skills\\.git)\\s+ref: (?<currentDigest>[a-f0-9]{40})"
      ],
      "depNameTemplate": "mattpocock/skills",
      "datasourceTemplate": "git-refs",
      "currentValueTemplate": "main",
      "versioningTemplate": "git"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["vendir"],
      "enabled": false
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["mattpocock/skills"],
      "automerge": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": false
  }
}
